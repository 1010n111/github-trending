# 本文件仅供本地调试使用。
# 在 GitHub Actions 中这些值来自仓库 Secrets，不读取 .env。

# LLM 接口配置（OpenAI 兼容协议）。Step 2 用它生成 article.json。
# 换厂商只改这三个值，代码与 workflow 都不用动。
#
# 免费档示例（都不需要信用卡）。实测延迟差距极大，建议把快的放主、慢的放备：
#   Groq       : https://api.groq.com/openai/v1      + openai/gpt-oss-120b   实测 1~5s
#   OpenRouter : https://openrouter.ai/api/v1        + openrouter/free       实测 47~149s
#   Cerebras   : https://api.cerebras.ai/v1          + llama-3.3-70b         （未实测）
#
# ⚠️ 模型 id 会被厂商下线，示例仅供参考；用 curl 打各家的 /models 端点确认当前可用模型。
#    实测 llama-3.3-70b-versatile 已从 Groq 下线，配了会直接 404 model_not_found。
# ⚠️ OpenRouter 的 openrouter/free 是"路由器"，会随机挑免费上游，
#    偶尔挑到只写 reasoning、content 返回 null 的模型（脚本会自动重试），
#    也偶尔挑到很慢的上游——这就是它适合当备而不是当主的原因。
# 注意：OpenCode 自家的免费模型（如 opencode/mimo-v2.6-flash-free）
# 服务端限制只能由 OpenCode 客户端调用，HTTP 直连会返回 403，不能填在这里。
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# 可选：备用 provider。主 provider 失败（限流/风控/超时）时自动切换。
# 免费档普遍会限流，配一个能显著降低当天开天窗的概率。
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=openrouter/free

# 是否允许"LLM 全挂时降级为模板生成"（保证每天都有文章）。
# 设为 off 则改为失败即退出（退出码 1），适合希望尽早暴露故障时。
TEMPLATE_FALLBACK=on

# 本地 Hexo 博客目录。留空则取本仓库同级的 ../Blog
HEXO_BLOG_DIR=

# SMTP 邮件配置
SMTP_SERVER=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
